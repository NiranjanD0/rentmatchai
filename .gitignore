# ==============================================================================
# RentMatch AI - Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
.env*.local
!.env.example
!.env.*.example
*.pem
*.key
*.cert

# ------------------------------------------------------------------------------
# Python & Backend (FastAPI / Alembic / Pytest)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
ENV/
env/

# Python Linting, Formatting & Type Checking
.mypy_cache/
.ruff_cache/
.pytest_cache/
.pyre/
.pytype/
dmypy.json
.dmypy.json

# Test Coverage
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
htmlcov/

# ------------------------------------------------------------------------------
# Node.js & Frontend (Next.js / TypeScript / Turbopack)
# ------------------------------------------------------------------------------
node_modules/
.next/
out/
build/
dist/
.turbo/
coverage/
.nyc_output/
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Package Manager Logs & Caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------------------------------------------
# Databases & Local Storage
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp

# ------------------------------------------------------------------------------
# IDEs & System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini

# Editors
.idea/
.vscode/
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Tooling & Generated Artifacts
# ------------------------------------------------------------------------------
/graphify-out
