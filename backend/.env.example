# Copy to backend/.env and edit. Never commit the real .env.

# Local PostgreSQL
# DATABASE_URL=postgresql+psycopg2://rentmatch:rentmatch@localhost:5432/rentmatch

# Supabase (Project Settings -> Database -> Connection string -> Session pooler)
DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Separate database used only by pytest (tables are dropped and recreated on every run)
TEST_DATABASE_URL=postgresql+psycopg2://rentmatch:rentmatch@localhost:5432/rentmatch_test

# JWT — generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

GOOGLE_CLIENT_ID = your-google-client-id-here
